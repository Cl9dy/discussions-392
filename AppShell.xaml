<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:Repro38612"
       x:Class="Repro38612.AppShell"
       FlyoutBehavior="Flyout">

    <Shell.FlyoutHeader>
        <Grid HeightRequest="80" BackgroundColor="LightGray">
            <Label Text="Repro 392 (SfCartesianChart)" VerticalOptions="Center" HorizontalOptions="Center" TextColor="Black" />
        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Naprave" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent Title="Naprave" Route="devices" ContentTemplate="{DataTemplate local:MainPage}" />
        <ShellContent Title="Graf (#392)" Route="chart" ContentTemplate="{DataTemplate local:ChartPage}" />
        <ShellContent Title="Chaos" Route="chaos" ContentTemplate="{DataTemplate local:ChaosPage}" />
        <ShellContent Title="Log" Route="log" ContentTemplate="{DataTemplate local:LogPage}" />
    </FlyoutItem>

    <Shell.FlyoutFooter>
        <Label Text="footer" HeightRequest="40" HorizontalTextAlignment="Center" TextColor="Black" />
    </Shell.FlyoutFooter>
</Shell>
